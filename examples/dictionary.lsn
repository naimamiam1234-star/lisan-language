# مثال الأرقام اللاتينية، والقواميس، والعربية الفصحى
ليكن الطالب = {"الاسم": "سلمى", "العمر": 23, "الدرجات": [17.5, 19, 16]}؛
اطبع("الاسم: " + الطالب["الاسم"])؛
اطبع("العمر: " + الطالب["العمر"])؛
اطبع("المادة الأولى: " + الطالب["الدرجات"][0])؛
الطالب["المدينة"] = "الرباط"؛
اطبع("عدد الحقول: " + طول(الطالب))؛
اطبع("المفاتيح: " + مفاتيح(الطالب))؛
