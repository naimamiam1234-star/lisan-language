# قوائم وأرقام عربية ودوال قياسية وحلقة لكل
دع قياسات = [١٨، ٢١، ٢٤]؛
قياسات[١] = ٢٢؛
قياسات = أضف(قياسات، ٢٦)؛
دع المجموع = ٠؛
لكل (قيمة في قياسات) {
    المجموع = المجموع + قيمة؛
}
اطبع("المجموع: " + المجموع)؛
اطبع("عدد القياسات: " + طول(قياسات))؛
اطبع("القياس الثاني: " + قياسات[١])؛
اطبع("هل يوجد ٢٦؟ " + يحتوي(قياسات، ٢٦))؛
