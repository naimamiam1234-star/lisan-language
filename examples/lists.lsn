# قوائم وأرقام عربية ودوال قياسية وحلقة لكل
دع قياسات = [18، 21، 24]؛
قياسات[1] = 22؛
قياسات = أضف(قياسات، 26)؛
دع المجموع = 0؛
لكل (قيمة في قياسات) {
    المجموع = المجموع + قيمة؛
}
اطبع("المجموع: " + المجموع)؛
اطبع("عدد القياسات: " + طول(قياسات))؛
اطبع("القياس الثاني: " + قياسات[1])؛
اطبع("هل يوجد 26؟ " + يحتوي(قياسات، 26))؛
