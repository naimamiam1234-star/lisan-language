# ملف اختبارات يمكن تنفيذه بالأمر: lisan --test examples/testing.lsn
ليكن القيم = مدى(5، 0، -2)؛
تحقق_يساوي(القيم، [5، 3، 1])؛

ليكن المجموع = 0؛
لكل (العدد في مدى(0، 10)) {
    إذا (العدد == 5) { تابع؛ }
    إذا (العدد > 7) { توقف؛ }
    المجموع = المجموع + العدد؛
}
تحقق_يساوي(المجموع، 23)؛
تحقق(2 ** 3 ** 2 == 512)؛
تحقق(1e3 == 1000)؛
