# لسان الأصلي: قوائم أرقام، فهرسة، حلقات، ونصوص UTF-8.
ليكن القيم = [10, 20, 30]؛
القيم[1] = 25؛
تحقق_يساوي(طول(القيم), 3)؛
ليكن المجموع = 0؛
لكل (القيمة في القيم) {
    المجموع = المجموع + القيمة؛
}
اطبع("مجموع القيم = " + المجموع)؛
تحقق_يساوي(القيم[1], 25)؛
اطبع("عدد الحروف = " + طول("سلام"))؛
تحقق("لسان" == "لسان")؛
لكل (العدد في مدى(5, 0, -2)) {
    اطبع(العدد)؛
}
اطبع("نجحت الاختبارات الأصلية")؛
