{
  "name": "lisan-language-support",
  "displayName": "Lisan (لسان) Language Support",
  "description": "تمييز الشيفرة العربية وملفات .lsn في Visual Studio Code",
  "version": "0.1.0",
  "publisher": "lisan-community",
  "private": true,
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{"id": "lisan", "aliases": ["لسان", "Lisan"], "extensions": [".lsn"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "lisan", "scopeName": "source.lisan", "path": "./syntaxes/lisan.tmLanguage.json"}],
    "snippets": [{"language": "lisan", "path": "./snippets/lisan.json"}]
  }
}
