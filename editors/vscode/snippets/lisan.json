{
  "Print": {
    "prefix": "اطبع",
    "body": [
      "اطبع(${1:\"مرحبا\"})؛"
    ],
    "description": "طباعة قيمة"
  },
  "Function": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:اسمي}(${2:معامل}) {",
      "    أرجع ${2:معامل}؛",
      "}"
    ],
    "description": "تعريف دالة"
  },
  "If": {
    "prefix": "إذا",
    "body": [
      "إذا (${1:صحيح}) {",
      "    ${2:اطبع(\"تم\")؛}",
      "}"
    ],
    "description": "تعليمة شرطية"
  },
  "ForEach": {
    "prefix": "لكل",
    "body": [
      "لكل (${1:عنصر} في ${2:مدى(10)}) {",
      "    ${3:اطبع(عنصر)؛}",
      "}"
    ],
    "description": "حلقة تمر على العناصر"
  },
  "Test": {
    "prefix": "تحقق",
    "body": [
      "تحقق_يساوي(${1:الفعلي}، ${2:المتوقع})؛"
    ],
    "description": "التحقق من مساواة قيمتين"
  }
}
